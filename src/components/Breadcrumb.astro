---
interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="container-blinkee pt-5">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-[color:var(--color-text-onlight-muted)]">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {item.href ? (
            <a href={item.href} class="hover:text-[color:var(--color-violet-deep)] transition-colors">
              {item.name}
            </a>
          ) : (
            <span aria-current="page" class="font-medium text-[color:var(--color-text-onlight)]">
              {item.name}
            </span>
          )}
          {i < items.length - 1 && (
            <span aria-hidden="true" class="text-[color:var(--color-text-onlight-muted)]">/</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
