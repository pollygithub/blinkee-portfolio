---
import { Image } from "astro:assets";
import type { Product } from "../data/products";

interface Props {
  product: Product;
  loading?: "lazy" | "eager";
}

const { product, loading = "lazy" } = Astro.props;
---

<article class="card-surface flex flex-col overflow-hidden group h-full">
  <div class="relative aspect-square overflow-hidden bg-[color:var(--color-ink)]">
    <Image
      src={product.image}
      alt={product.alt}
      loading={loading}
      decoding="async"
      width={600}
      height={600}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    {
      product.badge && (
        <span class="badge absolute top-3 left-3 bg-[color:var(--color-pink)] text-white">
          {product.badge}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-4">
    <h3 class="font-[family-name:var(--font-display)] font-semibold text-[color:var(--color-text-onlight)] leading-snug">
      {product.name}
    </h3>
    <p class="mt-1 text-sm text-[color:var(--color-text-onlight-muted)] flex-1">{product.blurb}</p>
    <div class="mt-3 flex items-center justify-between gap-2">
      <div class="flex items-baseline gap-2">
        <span class="font-[family-name:var(--font-display)] font-semibold text-lg text-[color:var(--color-text-onlight)]">
          ${product.price.toFixed(2)}
        </span>
        {
          product.compareAtPrice && (
            <span class="text-sm text-[color:var(--color-text-onlight-muted)] line-through">
              ${product.compareAtPrice.toFixed(2)}
            </span>
          )
        }
      </div>
    </div>
    <button
      type="button"
      data-add-to-cart
      data-product-name={product.name}
      class="btn btn-ghost-onlight mt-3 !py-2 text-sm w-full justify-center"
    >
      Add to Cart
    </button>
  </div>
</article>

<script>
  document.addEventListener("click", (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;
    const button = target.closest("[data-add-to-cart]");
    if (!button) return;

    window.dispatchEvent(
      new CustomEvent("blinkee:add-to-cart", {
        detail: { name: button.getAttribute("data-product-name") },
      })
    );

    const original = button.textContent;
    button.textContent = "Added ✓";
    button.setAttribute("disabled", "true");
    setTimeout(() => {
      button.textContent = original;
      button.removeAttribute("disabled");
    }, 1200);
  });
</script>
