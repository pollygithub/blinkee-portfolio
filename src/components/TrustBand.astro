---
const stats = [
  {
    icon: "truck",
    title: "Ships in 24 hours",
    detail: "Fast US shipping on in-stock orders",
  },
  {
    icon: "star",
    title: "4.8 / 5 stars",
    detail: "12,000+ verified customer reviews",
  },
  {
    icon: "people",
    title: "Trusted by thousands",
    detail: "Event planners, retailers, schools, teams & party people",
  },
  {
    icon: "tag",
    title: "Bulk pricing built in",
    detail: "Quantity breaks on 500+ items, no account needed",
  },
];

const payments = ["All Major Cards", "PayPal", "Amazon Pay", "Pay in 4"];
---

<section class="bg-[color:var(--color-paper-dim)] border-y border-[color:var(--color-paper-line)]" aria-label="Why shop with Blinkee.com">
  <div class="container-blinkee py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="flex items-start gap-3">
            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white text-[color:var(--color-violet-deep)]"
              aria-hidden="true"
            >
              {stat.icon === "truck" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 7h10v9H3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><path d="M13 10h4l3 3v3h-7v-6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><circle cx="7" cy="18" r="1.6" stroke="currentColor" stroke-width="2" /><circle cx="17" cy="18" r="1.6" stroke="currentColor" stroke-width="2" /></svg>
              )}
              {stat.icon === "star" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="m12 3 2.6 5.8 6.4.6-4.8 4.3 1.4 6.3L12 16.9l-5.6 3.1 1.4-6.3-4.8-4.3 6.4-.6L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
              )}
              {stat.icon === "people" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="2" /><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><circle cx="17.5" cy="9" r="2.3" stroke="currentColor" stroke-width="2" /><path d="M15.5 14.8c2.6.3 4.5 2.2 4.5 5.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
              )}
              {stat.icon === "tag" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 11.5V5a2 2 0 0 1 2-2h6.5L21 11.5 12.5 20 3 11.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><circle cx="8" cy="8" r="1.5" fill="currentColor" /></svg>
              )}
            </div>
            <div>
              <p class="font-[family-name:var(--font-display)] font-semibold text-[color:var(--color-text-onlight)]">{stat.title}</p>
              <p class="text-sm text-[color:var(--color-text-onlight-muted)]">{stat.detail}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-[color:var(--color-paper-line)] pt-6">
      <span class="text-xs font-semibold uppercase tracking-wide text-[color:var(--color-text-onlight-muted)]">
        Secure checkout with
      </span>
      {
        payments.map((p) => (
          <span class="rounded-full border border-[color:var(--color-paper-line)] bg-white px-3 py-1 text-xs font-semibold text-[color:var(--color-text-onlight-muted)]">
            {p}
          </span>
        ))
      }
    </div>
  </div>
</section>
