---
import type { Product } from "../data/products";
import ProductCard from "./ProductCard.astro";

interface Props {
  products: Product[];
  id: string;
}

const { products, id } = Astro.props;
---

<div
  class="relative"
  role="region"
  aria-roledescription="carousel"
  aria-label="Bestselling products"
>
  <div
    id={id}
    class="flex gap-4 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
    tabindex="0"
  >
    {
      products.map((product) => (
        <div class="w-[75%] shrink-0 snap-start sm:w-[42%] lg:w-[24%]">
          <ProductCard product={product} />
        </div>
      ))
    }
  </div>

  <div class="mt-4 flex justify-end gap-2">
    <button
      type="button"
      data-carousel-prev={id}
      class="rounded-full border-2 border-[color:var(--color-paper-line)] p-2.5 text-[color:var(--color-text-onlight)] hover:border-[color:var(--color-violet-deep)] hover:text-[color:var(--color-violet-deep)] transition-colors"
      aria-label="Scroll to previous products"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button
      type="button"
      data-carousel-next={id}
      class="rounded-full border-2 border-[color:var(--color-paper-line)] p-2.5 text-[color:var(--color-text-onlight)] hover:border-[color:var(--color-violet-deep)] hover:text-[color:var(--color-violet-deep)] transition-colors"
      aria-label="Scroll to next products"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll("[data-carousel-prev]").forEach((btn) => {
    const targetId = btn.getAttribute("data-carousel-prev");
    const track = targetId ? document.getElementById(targetId) : null;
    btn.addEventListener("click", () => {
      track?.scrollBy({ left: -track.clientWidth * 0.8, behavior: "smooth" });
    });
  });
  document.querySelectorAll("[data-carousel-next]").forEach((btn) => {
    const targetId = btn.getAttribute("data-carousel-next");
    const track = targetId ? document.getElementById(targetId) : null;
    btn.addEventListener("click", () => {
      track?.scrollBy({ left: track.clientWidth * 0.8, behavior: "smooth" });
    });
  });
</script>
