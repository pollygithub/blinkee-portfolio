---
const shopLinks = [
  { name: "Light Up Products", href: "/weddings/" },
  { name: "Chemical Glow", href: "/weddings/" },
  { name: "Mood Rings", href: "/weddings/" },
  { name: "Coins & Bills", href: "/coins-and-bills/" },
  { name: "Custom & Bulk Orders", href: "/custom-bulk/" },
];

const holidayLinks = [
  { name: "Halloween", href: "/holidays/" },
  { name: "Christmas", href: "/holidays/" },
  { name: "Mardi Gras", href: "/holidays/" },
  { name: "4th of July", href: "/holidays/" },
  { name: "New Year's Eve", href: "/holidays/" },
];

const serviceLinks = [
  { name: "Shipping & Returns", href: "#" },
  { name: "FAQs", href: "#" },
  { name: "Track My Order", href: "#" },
  { name: "Contact Us", href: "mailto:hello@blinkee.com" },
];
---

<footer class="bg-[color:var(--color-ink)] text-[color:var(--color-text-ondark)]">
  <div class="container-blinkee py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <a href="/" class="flex items-center gap-2 font-[family-name:var(--font-display)] text-xl font-semibold text-white">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-[color:var(--color-lime)]" aria-hidden="true"></span>
        Blinkee<span class="text-[color:var(--color-pink)]">.com</span>
      </a>
      <p class="mt-3 text-sm text-[color:var(--color-text-ondark-muted)] max-w-xs">
        Bright ideas for every occasion. LED jewelry, glow sticks, mood rings, and custom blinkees —
        glow loud, checkout easy.
      </p>

      <form id="newsletter-form" class="mt-6 max-w-sm" novalidate>
        <label for="newsletter-email" class="eyebrow text-[color:var(--color-lime)]">Get the glow list</label>
        <p class="mt-1 text-xs text-[color:var(--color-text-ondark-muted)]">
          New arrivals, holiday drops, and bulk-order deals. No spam, just sparkle.
        </p>
        <div class="mt-3 flex gap-2">
          <div class="flex-1">
            <label for="newsletter-email" class="sr-only">Email address</label>
            <input
              id="newsletter-email"
              name="email"
              type="email"
              required
              placeholder="you@example.com"
              class="w-full rounded-full px-4 py-2 text-sm text-[color:var(--color-text-onlight)] outline-none border border-white/20 focus:border-[color:var(--color-lime)]"
            />
          </div>
          <button type="submit" class="btn btn-lime !py-2 !px-5 text-sm shrink-0">Sign Up</button>
        </div>
        <p id="newsletter-message" class="mt-2 text-sm text-[color:var(--color-lime)]" role="status" aria-live="polite"></p>
      </form>
    </div>

    <nav aria-label="Shop">
      <h2 class="eyebrow text-[color:var(--color-cyan)]">Shop</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {shopLinks.map((l) => (
          <li><a href={l.href} class="text-[color:var(--color-text-ondark-muted)] hover:text-white transition-colors">{l.name}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Shop by holiday">
      <h2 class="eyebrow text-[color:var(--color-pink)]">Shop by Holiday</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {holidayLinks.map((l) => (
          <li><a href={l.href} class="text-[color:var(--color-text-ondark-muted)] hover:text-white transition-colors">{l.name}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Customer service">
      <h2 class="eyebrow text-[color:var(--color-violet)]">Customer Service</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {serviceLinks.map((l) => (
          <li><a href={l.href} class="text-[color:var(--color-text-ondark-muted)] hover:text-white transition-colors">{l.name}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div class="container-blinkee py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[color:var(--color-text-ondark-muted)]">
      <p>© 2026 Blinkee.com. Portfolio demo site — not a real store.</p>
      <div class="flex gap-4">
        <a href="#" class="hover:text-white transition-colors">Privacy</a>
        <a href="#" class="hover:text-white transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById("newsletter-form");
  const message = document.getElementById("newsletter-message");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const input = form.querySelector("#newsletter-email");
    if (!input || !input.checkValidity()) {
      if (message) message.textContent = "Please enter a valid email address.";
      input?.focus();
      return;
    }
    if (message) message.textContent = "You're on the list! Watch your inbox for bright ideas.";
    form.reset();
  });
</script>
