---
import { primaryNav, customBulkNav } from "../data/nav";
---

<header class="sticky top-0 z-50 bg-[color:var(--color-ink)] border-b border-white/10">
  <div class="container-blinkee flex items-center justify-between gap-2 sm:gap-3 py-3">
    <a
      href="/"
      class="flex items-center gap-1.5 sm:gap-2 shrink-0 font-[family-name:var(--font-display)] text-lg sm:text-2xl font-semibold text-white"
      aria-label="Blinkee.com home"
    >
      <span
        class="inline-block h-2.5 w-2.5 sm:h-3 sm:w-3 rounded-full bg-[color:var(--color-lime)]"
        style="box-shadow: var(--shadow-glow-lime);"
        aria-hidden="true"
      ></span>
      Blinkee<span class="text-[color:var(--color-pink)]">.com</span>
    </a>

    <nav
      id="primary-nav"
      aria-label="Primary categories"
      class="hidden lg:flex items-center gap-1 flex-wrap"
    >
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            class="px-3 py-2 rounded-full text-sm font-medium text-[color:var(--color-text-ondark-muted)] hover:text-white hover:bg-white/10 transition-colors"
          >
            {item.name}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 sm:gap-2 shrink-0">
      <a
        href={customBulkNav.href}
        aria-label={customBulkNav.name}
        class="badge bg-[color:var(--color-lime)] text-[color:var(--color-ink)] hover:brightness-95 transition !px-2.5 sm:!px-3"
        style="box-shadow: var(--shadow-glow-lime);"
      >
        <span class="sm:hidden">Bulk</span>
        <span class="hidden sm:inline">{customBulkNav.name}</span>
      </a>

      <button
        type="button"
        id="search-toggle"
        aria-expanded="false"
        aria-controls="search-panel"
        class="p-2 rounded-full text-white hover:bg-white/10 transition-colors"
        aria-label="Toggle search"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>

      <button
        type="button"
        id="cart-toggle"
        aria-expanded="false"
        aria-controls="cart-panel"
        class="relative p-2 rounded-full text-white hover:bg-white/10 transition-colors"
        aria-label="Open cart, 0 items"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 8h12l-1.2 10.2a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.8L6 8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
          <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span
          id="cart-count"
          class="absolute -top-0.5 -right-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-[color:var(--color-pink)] text-[10px] font-bold text-white"
        >0</span>
      </button>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="lg:hidden p-2 rounded-full text-white hover:bg-white/10 transition-colors"
        aria-label="Toggle menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="search-panel"
    class="hidden border-t border-white/10 bg-[color:var(--color-ink-soft)]"
  >
    <div class="container-blinkee py-3">
      <label for="search-input" class="sr-only">Search Blinkee.com</label>
      <div class="flex items-center gap-2 bg-white rounded-full px-4 py-2">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-[color:var(--color-text-onlight-muted)] shrink-0">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="Search glow sticks, mood rings, wedding favors…"
          class="w-full outline-none text-sm text-[color:var(--color-text-onlight)] placeholder:text-[color:var(--color-text-onlight-muted)]"
        />
      </div>
      <p class="mt-2 text-xs text-[color:var(--color-text-ondark-muted)]">
        Search is a visual demo in this portfolio build and isn't wired to live results.
      </p>
    </div>
  </div>

  <div
    id="cart-panel"
    class="hidden border-t border-white/10 bg-[color:var(--color-ink-soft)]"
  >
    <div class="container-blinkee py-6 text-center">
      <p id="cart-panel-message" class="text-white font-[family-name:var(--font-display)] font-semibold">Your glow cart is empty.</p>
      <p class="mt-1 text-sm text-[color:var(--color-text-ondark-muted)]">
        Cart is a visual demo in this portfolio build — add-to-cart isn't wired to checkout.
      </p>
      <a href="/weddings/" class="btn btn-lime mt-4 !py-2 !px-5 text-sm">Start Shopping</a>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Primary categories, mobile"
    class="hidden lg:hidden border-t border-white/10 bg-[color:var(--color-ink-soft)]"
  >
    <div class="container-blinkee py-3 flex flex-col">
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            class="px-2 py-3 text-sm font-medium text-[color:var(--color-text-ondark-muted)] hover:text-white border-b border-white/5 last:border-none"
          >
            {item.name}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  function setupToggle(buttonId: string, panelId: string, closeOthers: string[] = []) {
    const button = document.getElementById(buttonId);
    const panel = document.getElementById(panelId);
    if (!button || !panel) return;

    button.addEventListener("click", () => {
      const isOpen = panel.classList.contains("hidden") === false;
      closeOthers.forEach((id) => {
        document.getElementById(id)?.classList.add("hidden");
      });
      panel.classList.toggle("hidden", isOpen);
      button.setAttribute("aria-expanded", String(!isOpen));
    });
  }

  setupToggle("search-toggle", "search-panel", ["cart-panel", "mobile-nav"]);
  setupToggle("cart-toggle", "cart-panel", ["search-panel", "mobile-nav"]);
  setupToggle("menu-toggle", "mobile-nav", ["search-panel", "cart-panel"]);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      ["search-panel", "cart-panel", "mobile-nav"].forEach((id) => {
        document.getElementById(id)?.classList.add("hidden");
      });
      ["search-toggle", "cart-toggle", "menu-toggle"].forEach((id) => {
        document.getElementById(id)?.setAttribute("aria-expanded", "false");
      });
    }
  });

  let cartCount = 0;
  window.addEventListener("blinkee:add-to-cart", () => {
    cartCount += 1;
    const badge = document.getElementById("cart-count");
    const panelMessage = document.getElementById("cart-panel-message");
    const cartButton = document.getElementById("cart-toggle");
    if (badge) badge.textContent = String(cartCount);
    if (panelMessage) {
      panelMessage.textContent =
        cartCount === 1 ? "1 item in your glow cart." : `${cartCount} items in your glow cart.`;
    }
    cartButton?.setAttribute("aria-label", `Open cart, ${cartCount} items`);
  });
</script>
