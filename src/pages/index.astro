---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import OccasionCard from "../components/OccasionCard.astro";
import ProductCarousel from "../components/ProductCarousel.astro";
import TrustBand from "../components/TrustBand.astro";
import { occasions } from "../data/occasions";
import { getBestsellers } from "../data/products";
import homeHero from "../assets/images/hero/home-hero-v6.jpg";
import bulkHero from "../assets/images/hero/bulk-hero-v2.jpg";

const bestsellers = getBestsellers();
---

<BaseLayout
  title="Light-Up Party Supplies for Every Occasion"
  description="Shop LED jewelry, glow sticks, mood rings, and custom blinkees by occasion. Light up wedding favors, birthday glow packs, and holiday party supplies — plus quantity-break bulk pricing for schools, teams, and events."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-[color:var(--color-ink)]">
    <Image
      src={homeHero}
      alt="A crowd celebrating at a glowing nighttime party, raising glow sticks and LED wristbands in the air"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      width={2048}
      height={1152}
      class="absolute inset-0 h-full w-full object-cover opacity-70"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-[color:var(--color-ink)] via-[color:var(--color-ink)]/85 to-[color:var(--color-ink)]/40"
      aria-hidden="true"
    ></div>

    <div class="container-blinkee relative py-20 sm:py-28 lg:py-32">
      <div class="max-w-xl">
        <p class="eyebrow text-[color:var(--color-lime)]">Bright Ideas For Every Occasion</p>
        <h1 class="mt-4 font-[family-name:var(--font-display)] text-4xl font-semibold text-white sm:text-5xl lg:text-6xl">
          Find Your Glow, By Occasion
        </h1>
        <p class="mt-5 text-lg text-[color:var(--color-text-ondark-muted)]">
          Weddings, birthdays, bachelorette bashes, big games — shop LED jewelry, glow sticks,
          and light-up favors curated for what you're celebrating.
          <span class="text-white font-medium">Glow loud, checkout easy.</span>
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/weddings/" class="btn btn-lime">Shop by Occasion</a>
          <a href="/custom-bulk/" class="btn btn-outline-ondark">Custom &amp; Bulk Orders</a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-[color:var(--color-text-ondark-muted)]">
          <li class="flex items-center gap-1.5">
            <span class="text-[color:var(--color-lime)]" aria-hidden="true">★</span> 4.8/5 from 12,000+ reviews
          </li>
          <li>Ships in 24 hours</li>
          <li>Trusted by planners, schools &amp; teams</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Shop by Occasion -->
  <section class="container-blinkee py-16 sm:py-20" aria-labelledby="occasions-heading">
    <div class="max-w-2xl">
      <p class="eyebrow text-[color:var(--color-violet-deep)]">Shop by Occasion</p>
      <h2 id="occasions-heading" class="mt-2 font-[family-name:var(--font-display)] text-3xl font-semibold sm:text-4xl">
        What Are We Celebrating?
      </h2>
      <p class="mt-3 text-[color:var(--color-text-onlight-muted)]">
        Light up wedding favors, glow party supplies for birthdays, bachelorette bling, and more —
        tap your occasion and we'll do the rest.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {occasions.map((occasion, i) => (
        <OccasionCard occasion={occasion} loading={i < 4 ? "eager" : "lazy"} />
      ))}
    </div>
  </section>

  <!-- Bestseller carousel -->
  <section class="container-blinkee py-16 sm:py-20" aria-labelledby="bestsellers-heading">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-xl">
        <p class="eyebrow text-[color:var(--color-pink-deep)]">Fan Favorites</p>
        <h2 id="bestsellers-heading" class="mt-2 font-[family-name:var(--font-display)] text-3xl font-semibold sm:text-4xl">
          Bestsellers That Glow the Brightest
        </h2>
      </div>
      <a href="/weddings/" class="text-sm font-semibold text-[color:var(--color-violet-deep)] hover:underline">
        Shop all products →
      </a>
    </div>

    <div class="mt-10">
      <ProductCarousel id="bestseller-carousel" products={bestsellers} />
    </div>
  </section>

  <!-- Bulk & Custom Orders -->
  <section class="relative overflow-hidden bg-[color:var(--color-ink)]" aria-labelledby="bulk-heading">
    <div class="container-blinkee grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-2">
      <div>
        <p class="eyebrow text-[color:var(--color-cyan)]">For Schools, Teams &amp; Event Pros</p>
        <h2 id="bulk-heading" class="mt-2 font-[family-name:var(--font-display)] text-3xl font-semibold text-white sm:text-4xl">
          Buying for a Crowd? Let's Talk Bulk.
        </h2>
        <p class="mt-4 max-w-lg text-[color:var(--color-text-ondark-muted)]">
          Quantity-break pricing, custom logo branding, and a dedicated quote — without digging
          through the consumer catalog. Built for schools, sports teams, corporate events, and retailers.
        </p>

        <ul class="mt-6 space-y-3">
          <li class="flex items-start gap-2.5 text-[color:var(--color-text-ondark)]">
            <span class="mt-0.5 text-[color:var(--color-lime)]" aria-hidden="true">✓</span>
            Quantity breaks starting at 100 units
          </li>
          <li class="flex items-start gap-2.5 text-[color:var(--color-text-ondark)]">
            <span class="mt-0.5 text-[color:var(--color-lime)]" aria-hidden="true">✓</span>
            Full-color custom logo branding, LogoBlinkee-style
          </li>
          <li class="flex items-start gap-2.5 text-[color:var(--color-text-ondark)]">
            <span class="mt-0.5 text-[color:var(--color-lime)]" aria-hidden="true">✓</span>
            Dedicated support for schools, teams &amp; retailers
          </li>
        </ul>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/custom-bulk/" class="btn btn-lime">Get Bulk Pricing</a>
          <a href="/custom-bulk/#quote-form" class="btn btn-outline-ondark">Request a Quote</a>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-6 rounded-[2.5rem] bg-[color:var(--color-cyan)] opacity-20 blur-2xl" aria-hidden="true"></div>
        <Image
          src={bulkHero}
          alt="A group of sports team members and event staff wearing glowing custom LED wristbands and light-up pins at a nighttime event"
          loading="lazy"
          decoding="async"
          width={1200}
          height={675}
          class="relative w-full rounded-[var(--radius-blob)] object-cover aspect-[4/3]"
        />
      </div>
    </div>
  </section>

  <TrustBand />
</BaseLayout>
